<head>
    <title>Search</title>
    <%- include("../shared/css.ejs") %>
</head>
<body>
    <%- include("../shared/navbar.ejs") %>

    <div class="container">
        <div class="row">
            <div class="col-sm">
            </div>
            <div class="col-sm">
                <h3>Search Parameters:</h3>
                <form method="post" action="/search/do">
                    <div class="form-group">
                        <label for="dogSize">Dog Size</label>
                        <select type="text" class="form-control" id="dogSize" name="dogSize">
                            <option value="0">5 kg and less</option>
                            <option value="1">6-14 kg</option>
                            <option value="2">15 kg and more</option>
                        </select>
                    </div>
                    <button type="submit" style="margin-top: 20px" class="btn btn-primary">Search</button>
                </form>
            </div>
            <div class="col-sm">
            </div>
        </div>
    </div>
</body>